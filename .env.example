# copy to .env and `set -a; source .env; set +a` (or use direnv)
# Every variable is optional; the defaults live in ragio/config.py.
RAGIO_FEED_URL=https://feeds.simplecast.com/EmVW7VGp
RAGIO_WHISPER_BACKEND=faster-whisper # faster-whisper (installed by requirements.txt) | mlx (Apple Silicon: pip install mlx-whisper)
RAGIO_WHISPER_MODEL=large-v3
RAGIO_WHISPER_MLX_REPO=mlx-community/whisper-large-v3-mlx
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
RAGIO_EMBED_MODEL=nomic-embed-text
RAGIO_LLM_MODEL=qwen2.5:14b
RAGIO_HYBRID=1
RAGIO_AUDIO_BACKEND=none             # none | openai-compatible | transformers

# --- further knobs, shown with their defaults ---
# RAGIO_ROOT=<repo root>             # data/ (audio, transcripts, clips, SQLite) is created under this
# RAGIO_WHISPER_COMPUTE=int8         # faster-whisper compute_type (e.g. float16 on an NVIDIA GPU)
# RAGIO_WINDOW_WORDS=220             # target words per retrieval window
# RAGIO_WINDOW_SECONDS=120           # max seconds per window
# RAGIO_WINDOW_OVERLAP=1             # segments shared between consecutive windows
# RAGIO_SEGMENT_COLLECTION=ragio_segments
# RAGIO_EPISODE_COLLECTION=ragio_episodes
# RAGIO_LLM_CONTEXT=16384            # Ollama context window
# RAGIO_AUDIO_URL=http://localhost:8001/v1
# RAGIO_AUDIO_MODEL=Qwen/Qwen2-Audio-7B-Instruct
# RAGIO_TOP_K=8                      # dense hits per question
# RAGIO_SPARSE_TOP_K=12              # BM25 hits per question (hybrid only)
# RAGIO_NEIGHBORS=1                  # expand each hit by ±N windows
